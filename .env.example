DATABASE_URL=postgres://analytics:analytics@localhost:5432/quick_analytics
PORT=3000
NODE_ENV=development

# 32-byte key (base64/hex) for AES-256-GCM encryption of Kaspi credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENC_KEY=
# Secret for signing app JWTs.
JWT_SECRET=

# OpenAI — powers AI business insights. Feature returns 503 if unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email (Resend) — powers the password-reset link.
# Without RESEND_API_KEY: dev logs the email, production returns 503.
# The MAIL_FROM domain must be verified in Resend (DNS records on quicksell.kz).
RESEND_API_KEY=
MAIL_FROM="QuickSell <no-reply@quicksell.kz>"
# Frontend origin the reset link points at (no trailing slash).
# The app lives on web.quicksell.kz; quicksell.kz itself is the landing page.
APP_BASE_URL=https://web.quicksell.kz

# Browser origins allowed to call the API (comma-separated).
# Unset: web.quicksell.kz in production, the Vite dev server otherwise.
# Only matters if the API gets its own host (api.quicksell.kz) — the app itself
# calls /api on its own origin.
CORS_ORIGINS=https://web.quicksell.kz

# Set to 1 when the API runs behind nginx, so client IPs are recorded correctly.
TRUST_PROXY=1

# /docs is public in development. In production it needs these; leave them
# unset on the server and the docs are not published at all.
SWAGGER_USER=
SWAGGER_PASSWORD=

# Postgres container credentials (docker-compose reads these).
# CHANGE THE PASSWORD ON THE SERVER and mirror it in DATABASE_URL.
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
POSTGRES_DB=quick_analytics

# Kaspi discovery spike (standalone script only — not app config).
# Token is a PER-SELLER credential; prefer passing via --token= CLI arg.
KASPI_BASE_URL=https://kaspi.kz/shop/api
# KASPI_API_TOKEN=<per-seller token, do not commit>
